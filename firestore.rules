rules_version = '2';

// Each signed-in user can read and write only their own documents:
// users/{uid} (profile) and users/{uid}/{tasks|habits|checkins|dayLogs|sessions|reviews}/{id}.
service cloud.firestore {
  match /databases/{database}/documents {
    // Daily wallpaper images. The document id contains a long random token, so
    // anyone with the private link can download one image; only the owner can
    // list, write or delete them.
    match /wallpapers/{id} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid
          && collection in ['tasks', 'habits', 'checkins', 'dayLogs', 'sessions', 'reviews'];
      }
    }
  }
}
